:root {
  --bg: #0b1020;
  --panel: #121a2b;
  --panel-alt: #172235;
  --text: #ebf2ff;
  --muted: #99a9c7;
  --line: #2a3a58;
  --primary: #7dd3fc;
  --primary-strong: #38bdf8;
  --success: #4ade80;
  --warning: #fbbf24;
  --danger: #f87171;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100vh;
  font-family: Arial, Helvetica, sans-serif;
  background: radial-gradient(circle at top, #111827 0%, var(--bg) 55%);
  color: var(--text);
}

.app-shell {
  width: min(1200px, calc(100% - 32px));
  margin: 0 auto;
  padding: 32px 0 48px;
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  padding: 20px 24px;
  border: 1px solid var(--line);
  border-radius: 16px;
  background: rgba(18, 26, 43, 0.9);
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
}

.eyebrow {
  margin: 0 0 8px;
  color: var(--primary);
  letter-spacing: 0.08em;
  text-transform: uppercase;
  font-size: 12px;
}

h1 {
  margin: 0;
  font-size: clamp(1.8rem, 2vw, 2.6rem);
}

.topbar-status {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  color: var(--muted);
  font-size: 0.9rem;
}

.hero {
  margin-top: 24px;
  padding: 22px 24px;
  border: 1px solid var(--line);
  border-radius: 16px;
  background: var(--panel-alt);
}

.hero h2 {
  margin-top: 0;
  margin-bottom: 10px;
}

.hero p {
  margin: 0;
  max-width: 720px;
  color: var(--muted);
  line-height: 1.6;
}

.service-grid {
  margin-top: 24px;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 18px;
}

.service-card {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 12px;
  min-height: 220px;
  padding: 20px;
  border: 1px solid var(--line);
  border-radius: 16px;
  background: var(--panel);
}

.status {
  align-self: flex-start;
  display: inline-flex;
  padding: 6px 10px;
  border-radius: 999px;
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
}

.status.connected {
  background: rgba(74, 222, 128, 0.12);
  color: var(--success);
}

.status.disconnected {
  background: rgba(248, 113, 113, 0.1);
  color: var(--danger);
}

.service-card h3 {
  margin: 0;
  font-size: 1.2rem;
}

.service-card p {
  margin: 0;
  color: var(--muted);
  line-height: 1.6;
  flex: 1;
}

.actions {
  display: flex;
  justify-content: flex-start;
}

button {
  border: none;
  border-radius: 10px;
  padding: 10px 14px;
  font-weight: 700;
  cursor: pointer;
  transition: transform 0.15s ease, opacity 0.15s ease;
}

button:hover {
  transform: translateY(-1px);
}

button.primary {
  background: var(--primary);
  color: #04111f;
}

button.secondary {
  background: rgba(125, 211, 252, 0.12);
  color: var(--primary);
  border: 1px solid rgba(125, 211, 252, 0.35);
}

@media (max-width: 700px) {
  .topbar {
    flex-direction: column;
    align-items: flex-start;
  }

  .topbar-status {
    align-items: flex-start;
  }
}
